<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <LinearLayout
                android:id="@+id/timeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="@drawable/card_background"
                android:clickable="true"
                android:focusable="true">

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/hour1TextView"
                    android:layout_width="68dp"
                    android:layout_height="96dp" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/hour2TextView"
                    android:layout_width="68dp"
                    android:layout_height="96dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="60sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/colon_color"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="@color/colon_color"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/minute1TextView"
                    android:layout_width="68dp"
                    android:layout_height="96dp" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/minute2TextView"
                    android:layout_width="68dp"
                    android:layout_height="96dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginVertical="2dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/card_background">

                <!-- 横屏全部一行: 日期 + 星期 + 节气 + 按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/dateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/date_blue"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="4dp"
                        tools:text="2024年12月31日" />

                    <TextView
                        android:id="@+id/weekdayTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_accent"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:paddingHorizontal="4dp"
                        tools:text="星期二" />

                    <TextView
                        android:id="@+id/jieqiTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/jieqi_orange"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="4dp"
                        tools:text="立春" />

                    <TextView
                        android:id="@+id/resetTimeButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:text="⟳"
                        android:textSize="18sp"
                        android:textColor="@color/colon_color"
                        android:gravity="center"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_round_transparent"
                        android:contentDescription="恢复当前时间" />

                </LinearLayout>

                <!-- 分隔线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_light"
                    android:layout_marginVertical="3dp"
                    android:alpha="0.4" />

                <!-- 第2行: 四柱 + 复制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/fourPillarsTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/gold_faint"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        tools:text="甲辰年 丙子月 乙未日 甲申时" />

                    <TextView
                        android:id="@+id/copyButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="⧉"
                        android:textSize="16sp"
                        android:textColor="@color/gold_faint"
                        android:gravity="center"
                        android:layout_marginStart="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/btn_round_transparent"
                        android:contentDescription="复制排盘信息" />

                </LinearLayout>

                <!-- 第3行: 时辰运势（上行：时辰+当令，下行：宜xxx） -->
                <TextView
                    android:id="@+id/timeFortuneTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.03"
                    android:layout_marginTop="4dp"
                    tools:text="辰(7-9) 胃经当令&#10;宜进朝膳，纳谷最良" />

                <!-- 第4行: 九星值符义 -->
                <TextView
                    android:id="@+id/panStarTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/explanation_gray"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.06"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="4dp"
                    tools:text="文星主事，利学业文书" />

                <!-- 第5行: 八门/建议 -->
                <TextView
                    android:id="@+id/panExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/jieqi_orange"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.06"
                    android:lineSpacingExtra="2dp"
                    android:paddingHorizontal="4dp"
                    tools:text="开门通达，诸事可成" />

            </LinearLayout>

        </LinearLayout>

        </FrameLayout>

        </ScrollView>

        <LinearLayout
            android:id="@+id/ninePalaceContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:layout_marginVertical="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/card_background"
            android:clickable="true"
            android:focusable="true">

            <com.example.timedisplay.NinePalacePanel
                android:id="@+id/ninePalacePanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/ninePalaceChevron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:textSize="12sp"
                android:textColor="#88FFFFFF"
                android:fontFamily="sans-serif-light"
                android:text="奇门九宫 ›" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/rotationLockButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="锁"
        android:textSize="18sp"
        android:textColor="@color/gold_faint"
        android:gravity="center"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/btn_round_transparent"
        android:contentDescription="锁定/解锁横竖屏" />

</FrameLayout>