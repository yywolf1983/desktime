<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/mainLayout" android:layout_width="match_parent" android:layout_height="match_parent" tools:context=".MainActivity">
    <com.example.timedisplay.FrostedGlassBackground android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="32dp">
            <LinearLayout android:id="@+id/timeContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="8dp" android:clickable="true" android:focusable="true" android:background="@android:color/transparent">
                <com.example.timedisplay.SevenSegmentDisplay android:id="@+id/hour1TextView" android:layout_width="78dp" android:layout_height="98dp"/>
                <com.example.timedisplay.SevenSegmentDisplay android:id="@+id/hour2TextView" android:layout_width="78dp" android:layout_height="98dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=":" android:textSize="68sp" android:textColor="#FF87CEEB" android:fontFamily="sans-serif-black" android:shadowColor="#FF87CEEB" android:shadowDx="0" android:shadowDy="0" android:shadowRadius="4"/>
                <com.example.timedisplay.SevenSegmentDisplay android:id="@+id/minute1TextView" android:layout_width="78dp" android:layout_height="98dp"/>
                <com.example.timedisplay.SevenSegmentDisplay android:id="@+id/minute2TextView" android:layout_width="78dp" android:layout_height="98dp"/>
            </LinearLayout>
            <TextView android:id="@+id/dateTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/tech_blue" android:fontFamily="sans-serif-light" android:gravity="center" android:layout_marginVertical="4dp" tools:text="2024年12月31日 星期二"/>
            <TextView android:id="@+id/fourPillarsTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/tech_cyan" android:fontFamily="sans-serif-light" android:gravity="center" android:layout_marginVertical="4dp" tools:text="甲辰年 丙子月 乙未日 甲申时"/>
            <TextView android:id="@+id/timeFortuneTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/tech_silver" android:fontFamily="sans-serif-light" android:gravity="center" android:layout_marginVertical="4dp" tools:text="子时(23-1点): 阴气最重，宜静养安神"/>
            <TextView android:id="@+id/ninePalaceExplanation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/tech_silver" android:fontFamily="sans-serif-light" android:gravity="center" android:layout_marginVertical="4dp" tools:text="九宫格基于当前四柱信息计算"/>
        </LinearLayout>
        <com.example.timedisplay.NinePalacePanel android:id="@+id/ninePalacePanel" android:layout_width="280dp" android:layout_height="280dp"/>
    </LinearLayout>
    <TextView android:id="@+id/detailedInterpretation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
</FrameLayout>
