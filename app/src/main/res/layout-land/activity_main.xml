<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/rotationLockButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="🔒"
        android:textSize="18sp"
        android:textColor="#33FFFFFF"
        android:gravity="center"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="锁定/解锁横竖屏" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="32dp">

            <LinearLayout
                android:id="@+id/timeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent">

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/hour1TextView"
                    android:layout_width="78dp"
                    android:layout_height="98dp" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/hour2TextView"
                    android:layout_width="78dp"
                    android:layout_height="98dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="68sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#FF87CEEB"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/minute1TextView"
                    android:layout_width="78dp"
                    android:layout_height="98dp" />

                <com.example.timedisplay.SevenSegmentDisplay
                    android:id="@+id/minute2TextView"
                    android:layout_width="78dp"
                    android:layout_height="98dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginVertical="4dp">

                <TextView
                    android:id="@+id/dateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#6B8DD6"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    tools:text="2024年12月31日 星期二" />

                <TextView
                    android:id="@+id/jieqiTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#FFB84D"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    tools:text="立春" />

                <TextView
                    android:id="@+id/resetTimeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⟳"
                    android:textSize="20sp"
                    android:textColor="#FF87CEEB"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginVertical="4dp">

                <TextView
                    android:id="@+id/fourPillarsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    tools:text="甲辰年 丙子月 乙未日 甲申时" />

                <TextView
                    android:id="@+id/copyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="18sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="复制派盘信息" />

            </LinearLayout>

            <TextView
                    android:id="@+id/timeFortuneTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#8FBC8F"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:layout_marginVertical="4dp"
                    tools:text="子时(23-1点): 阴气最重，宜静养安神" />

            <TextView
                android:id="@+id/panExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#B19CD9"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginVertical="6dp"
                android:letterSpacing="0.08"
                android:maxLines="2"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="8dp"
                tools:text="阳遁格局 文星主事 利于文书 开门见喜\n事易成就 气场旺盛 万事通达 宜积极进取" />

        </LinearLayout>

        <com.example.timedisplay.NinePalacePanel
            android:id="@+id/ninePalacePanel"
            android:layout_width="280dp"
            android:layout_height="280dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/detailedInterpretation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>