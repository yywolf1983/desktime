<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    tools:context=".MainActivity">

    <!-- 顶部区域 - 时间显示 -->
    <LinearLayout
        android:id="@+id/topTimeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="40dp">

        <!-- 时间容器 -->
        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 小时数字 -->
            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour1TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour2TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <com.example.timedisplay.ColonDisplay
                android:id="@+id/colon1TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="0.5"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp" />

            <!-- 分钟数字 -->
            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute1TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute2TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <com.example.timedisplay.ColonDisplay
                android:id="@+id/colon2TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="0.5"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp" />

            <!-- 秒数字 -->
            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/second1TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/second2TextView"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 九宫格气门派盘（显示在左下角） -->
    <com.example.timedisplay.NinePalacePanel
        android:id="@+id/ninePalacePanel"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp" />

    <!-- 底部区域 - 右侧信息（在九宫格和右边界之间居中） -->
    <RelativeLayout
        android:id="@+id/bottomInfoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/ninePalacePanel"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <!-- 信息垂直排列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 日期显示 -->
            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/tech_blue"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:singleLine="false"
                android:letterSpacing="0.08"
                android:shadowColor="@color/tech_blue"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                tools:text="2024年12月31日 星期二" />

            <!-- 四柱显示 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginVertical="5dp">
                
                <TextView
                    android:id="@+id/fourPillarsTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/tech_cyan"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:singleLine="false"
                    android:letterSpacing="0.08"
                    android:shadowColor="@color/tech_cyan"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    tools:text="甲辰年 丙子月 乙未日 甲申时" />
            </LinearLayout>

            <!-- 九宫格解释 -->
            <TextView
                android:id="@+id/ninePalaceExplanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/tech_silver"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:singleLine="false"
                android:letterSpacing="0.08"
                android:shadowColor="@color/tech_silver"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1"
                tools:text="九宫格基于当前四柱信息计算，显示奇门遁甲的星门布局。" />
            
            <!-- 详细解读 -->
            <TextView
                android:id="@+id/detailedInterpretation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/tech_light_blue"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginVertical="3dp"
                android:singleLine="false"
                android:letterSpacing="0.08"
                android:shadowColor="@color/tech_light_blue"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1"
                android:visibility="gone"
                tools:text="详细解读内容将显示在这里..." />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
