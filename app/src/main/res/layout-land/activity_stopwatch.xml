<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stopwatchLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StopwatchActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 返回按钮 - 左上角 -->
    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← 返回"
        android:textSize="14sp"
        android:textColor="#FF87CEEB"
        android:padding="12dp"
        android:layout_gravity="start|top" />

    <!-- 居中内容 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <!-- 时间显示 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour1"
                android:layout_width="48dp"
                android:layout_height="60dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour2"
                android:layout_width="48dp"
                android:layout_height="60dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="24sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute1"
                android:layout_width="48dp"
                android:layout_height="60dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute2"
                android:layout_width="48dp"
                android:layout_height="60dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="24sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond1"
                android:layout_width="48dp"
                android:layout_height="60dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond2"
                android:layout_width="48dp"
                android:layout_height="60dp" />

        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="80dp"
                android:layout_height="44dp"
                android:text="重置"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:background="@drawable/button_secondary_background"
                android:enabled="false"
                android:alpha="0.5"
                android:clickable="true" />

            <View
                android:layout_width="12dp"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/startStopButton"
                android:layout_width="80dp"
                android:layout_height="44dp"
                android:text="开始"
                android:textSize="14sp"
                android:textColor="#FF0A0A14"
                android:gravity="center"
                android:background="@drawable/button_primary_background"
                android:clickable="true" />

        </LinearLayout>

        <!-- 记录列表 -->
        <ScrollView
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:maxHeight="80dp">

            <LinearLayout
                android:id="@+id/lapListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
