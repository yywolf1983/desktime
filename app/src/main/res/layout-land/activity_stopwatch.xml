<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stopwatchLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StopwatchActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← 返回"
        android:textSize="18sp"
        android:textColor="#FF87CEEB"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="16dp"
        android:layout_gravity="start|top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="88dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="24dp">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour1"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour2"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="50sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute1"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute2"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="50sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond1"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond2"
                android:layout_width="78dp"
                android:layout_height="90dp" />

            <TextView
                android:id="@+id/stopwatchMillis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=".00"
                android:textSize="36sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="100dp"
                android:layout_height="52dp"
                android:text="重置"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center"
                android:background="@drawable/button_secondary_background"
                android:enabled="false"
                android:alpha="0.5"
                android:clickable="true" />

            <View
                android:layout_width="20dp"
                android:layout_height="52dp" />

            <TextView
                android:id="@+id/startStopButton"
                android:layout_width="100dp"
                android:layout_height="52dp"
                android:text="开始"
                android:textSize="16sp"
                android:textColor="#FF0A0A14"
                android:gravity="center"
                android:background="@drawable/button_primary_background"
                android:clickable="true" />

        </LinearLayout>

        <ScrollView
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:maxHeight="80dp">

            <LinearLayout
                android:id="@+id/lapListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
