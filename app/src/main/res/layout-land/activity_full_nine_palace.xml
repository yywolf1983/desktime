<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/fullPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="奇门遁甲排盘"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.05"/>

            <com.example.timedisplay.FullNinePalacePanel
                android:id="@+id/fullNinePalacePanel"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@android:color/transparent">

            <LinearLayout
                android:id="@+id/fullNinePalaceLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 基本信息"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expBasic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 综合建议"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expOverall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⏰ 时辰运势"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧭 方位吉凶"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expDirection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ 今日宜忌"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expYiJi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⭐ 值符值使"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expZhifuZhishi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌙 日时关系"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expGan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:layout_marginBottom="6dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏠 生活提示"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        android:paddingBottom="3dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expLife"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:layout_marginBottom="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏛 天盘地盘"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expTianDiPanDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="4dp"/>
                    <com.example.timedisplay.DetailedNinePalacePanel
                        android:id="@+id/expTianDiPan"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:layout_marginBottom="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ 九星排布"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expNineStarsDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="4dp"/>
                    <com.example.timedisplay.DetailedNinePalacePanel
                        android:id="@+id/expNineStars"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:layout_marginBottom="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚪 八门排布"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expEightDoorsDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="4dp"/>
                    <com.example.timedisplay.DetailedNinePalacePanel
                        android:id="@+id/expEightDoors"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:layout_marginBottom="3dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👑 八神排布"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expGodsDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="4dp"/>
                    <com.example.timedisplay.DetailedNinePalacePanel
                        android:id="@+id/expGods"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏯 各宫详解"
                        android:textColor="@color/gold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.02"/>
                    <TextView
                        android:id="@+id/expPalacesDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="4dp"/>
                    <com.example.timedisplay.DetailedNinePalacePanel
                        android:id="@+id/expPalaces"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>