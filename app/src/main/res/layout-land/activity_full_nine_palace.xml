<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/fullNinePalaceLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/fullPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="奇门遁甲排盘"
                android:textColor="#87CEEB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/fullPageFourPillars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ADD8E6"
                    android:textSize="13sp"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/fullPagePanelInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00BFFF"
                    android:textSize="13sp"/>

            </LinearLayout>

            <com.example.timedisplay.FullNinePalacePanel
                android:id="@+id/fullNinePalacePanel"
                android:layout_width="200dp"
                android:layout_height="200dp"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start">

                <TextView
                    android:id="@+id/fullPageExplanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#87CEEB"
                    android:textSize="18sp"
                    android:lineSpacingExtra="8dp"/>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>