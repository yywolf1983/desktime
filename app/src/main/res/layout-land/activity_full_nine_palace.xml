<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="9dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_background"
            android:gravity="center">
            <TextView
                android:id="@+id/fullPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="奇门遁甲排盘"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
        </LinearLayout>

        <!-- 横屏：左右平均分割，九宫在左居中，文字在右滚动 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:weightSum="5"
            android:orientation="horizontal">

            <!-- 左侧：九宫（占 40%，居中显示，取最大尺寸） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:padding="0dp"
                android:background="@drawable/card_background"
                android:gravity="center">
                <com.example.timedisplay.FullNinePalacePanel
                    android:id="@+id/fullNinePalacePanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- 右侧：文字内容（占 60%，可独立滚动） -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:fillViewport="true"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/fullNinePalaceLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:id="@+id/zhkyGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="综合研判"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="10dp"/>
                        <TextView
                            android:id="@+id/expSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="今日格局吉利，宜行动进取，东南方为吉位"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/expBasic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="时空格局"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="值符值使"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expZhifuZhishi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="日时关系"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expGan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="方位吉凶"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expDirection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="用事要诀"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="日辰宜忌"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expYiJi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="时辰运势"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="日用提示"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expLife"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="综合建言"
                            android:textSize="13sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>
                        <TextView
                            android:id="@+id/expOverall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="专业精解"
                            android:textSize="16sp"
                            android:textColor="@color/gold"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="天盘地盘"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="天盘＝星神飞布的上层（变化），地盘＝八卦方位的下层（固定），两层叠加看吉凶。"
                            android:textSize="15sp"
                            android:textColor="@color/text_annotation"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expTianDiPanDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="九星排布"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expNineStarsDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="八门排布"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expEightDoorsDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="八神排布"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expGodsDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="各宫详解"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="逐宫拆解，列星、门、神之组合与吉凶。"
                            android:textSize="15sp"
                            android:textColor="@color/text_annotation"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expPalacesDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="9dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/card_background">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="排盘依据"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"
                            android:paddingBottom="6dp"
                            android:letterSpacing="0.05"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@drawable/gold_separator"
                            android:layout_marginBottom="10dp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="说明本盘所用的历法、奇门局数（阳遁／阴遁几局）与起局规则，便于核对。"
                            android:textSize="15sp"
                            android:textColor="@color/text_annotation"
                            android:layout_marginBottom="6dp"/>
                        <TextView
                            android:id="@+id/expPaipanYiju"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="5dp"
                            android:lineSpacingMultiplier="1.05"/>
                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
