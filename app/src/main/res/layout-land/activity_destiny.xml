<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- 左侧：四柱快速预览 -->
        <ScrollView
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp"
                android:background="@drawable/card_background">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🧬 命理解读"
                    android:textColor="@color/gold" android:textSize="18sp" android:textStyle="bold"
                    android:layout_marginBottom="14dp" android:letterSpacing="0.08"/>

                <!-- 四柱大字 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:id="@+id/fourPillarsLabel"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gold"
                    android:layout_marginBottom="6dp"/>

                <View android:layout_width="80dp" android:layout_height="1dp"
                    android:background="@drawable/gold_separator" android:layout_marginBottom="12dp"/>

                <!-- 日主 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:orientation="vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="日主" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/dayMasterLabelL"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/gold"/>
                    <TextView android:id="@+id/dayDescTextL"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:gravity="center" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View android:layout_width="60dp" android:layout_height="1dp"
                    android:background="@drawable/gold_separator" android:layout_marginBottom="12dp"/>

                <!-- 身强身弱标志 -->
                <TextView android:id="@+id/strengthTagL"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold" android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" android:background="@drawable/card_border"
                    android:layout_marginBottom="14dp"/>

                <!-- 核心快览 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="6dp"
                    android:background="@drawable/card_border" android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingVertical="2dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="生肖" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/zodiacLabelL" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="12sp" android:textColor="@color/wuxing_fire" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingVertical="2dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="纳音" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/nayinLabelL" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingVertical="2dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="日支" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/dayZhiLabelL" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingVertical="2dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="长生" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/changshengLabelL" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:paddingVertical="2dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="五行" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                        <TextView android:id="@+id/wuxingSumL" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>
        </ScrollView>

        <!-- 右侧：滚动内容区 -->
        <ScrollView
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:fillViewport="true" android:background="@android:color/transparent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingLeft="6dp" android:paddingRight="4dp">

                <!-- 命局核心详情（横屏补齐） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="☀ 命局核心" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="8dp"/>

                    <!-- 纳音四柱 -->
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🎵 纳音" android:textColor="@color/gold" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.03" android:layout_marginBottom="4dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/nayinYearLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:textSize="13sp" android:textColor="@color/gold" android:textStyle="bold"
                            android:padding="4dp" android:background="@drawable/card_border" android:layout_marginEnd="2dp"/>
                        <TextView android:id="@+id/nayinMonthLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:textSize="13sp" android:textColor="@color/gold" android:textStyle="bold"
                            android:padding="4dp" android:background="@drawable/card_border" android:layout_marginHorizontal="2dp"/>
                        <TextView android:id="@+id/nayinDayLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:textSize="13sp" android:textColor="@color/gold" android:textStyle="bold"
                            android:padding="4dp" android:background="@drawable/card_border" android:layout_marginHorizontal="2dp"/>
                        <TextView android:id="@+id/nayinTimeLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                            android:textSize="13sp" android:textColor="@color/gold" android:textStyle="bold"
                            android:padding="4dp" android:background="@drawable/card_border" android:layout_marginStart="2dp"/>
                    </LinearLayout>

                    <TextView android:id="@+id/nayinText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="11sp" android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- 命宫 -->
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingVertical="2dp" android:paddingHorizontal="4dp"
                        android:background="@drawable/card_border" android:layout_marginBottom="6dp">
                        <TextView android:id="@+id/mingGongValue" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
                            android:textColor="@color/gold" android:layout_marginEnd="6dp"/>
                        <TextView android:id="@+id/mingGongDesc" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_accent" android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <!-- 十二长生 -->
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🔄 十二长生" android:textColor="@color/gold" android:textSize="12sp"
                        android:textStyle="bold" android:letterSpacing="0.03" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/changshengText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="11sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 十神 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🔗 十神排布" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/tenGodsText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 五行力量 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⚡ 五行力量" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/wuxingPowerText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/xijiText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"
                        android:padding="8dp" android:background="@drawable/card_border"/>
                </LinearLayout>

                <!-- 性格 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🌟 性格特点" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/personalityText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 事业 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="💼 事业运势" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/careerText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 财富 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="💰 财富运势" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/wealthText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 感情 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="💕 感情婚姻" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/relationshipText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 健康 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🏥 健康建议" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/healthText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 人际 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🤝 人际关系" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/socialText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 地支藏干 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🌿 地支藏干" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/hiddenStemsText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 命局格局 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🏰 命局格局" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/patternText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- 六亲 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="👪 六亲浅析" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/sixRelText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 合冲刑害 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⚔ 合冲刑害" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/branchRelText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 四柱详解 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="📜 四柱详解" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/pillarsDetailText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>

                <!-- 人生建议 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="🎯 人生发展建议" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/lifeAdviceText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="4dp"/>
                </LinearLayout>

                <!-- 命局综评 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp" android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="📊 命局综评" android:textColor="@color/gold" android:textSize="14sp"
                        android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="6dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@drawable/gold_separator" android:layout_marginBottom="6dp"/>
                    <TextView android:id="@+id/levelText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="13sp" android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="4dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="※ 以上解读基于四柱命理分析，仅供参考。命运掌握在自己手中，积极努力、保持善良才是最好的风水。"
                        android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
