<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 罗盘 - 固定位置，不随滚动 -->
        <com.example.timedisplay.LuoPanView
            android:id="@+id/luoPanView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical" />

        <!-- 信息部分 - 可滚动 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#28000000"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/directionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="方位: 坎(北)"
                        android:textSize="17sp"
                        android:textColor="#FFD700"
                        android:paddingRight="20dp" />

                    <TextView
                        android:id="@+id/mountainInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坐山: 子"
                        android:textSize="17sp"
                        android:textColor="#87CEEB" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#40FFFFFF"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/wuxingInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="五行: 水"
                        android:textSize="15sp"
                        android:textColor="#00CED1"
                        android:paddingRight="16dp" />

                    <TextView
                        android:id="@+id/shierZhixingInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="十二支: 子"
                        android:textSize="15sp"
                        android:textColor="#DDA0DD"
                        android:paddingRight="16dp" />

                    <TextView
                        android:id="@+id/tianganInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="天干: 壬"
                        android:textSize="15sp"
                        android:textColor="#98FB98" />

                </LinearLayout>

                <TextView
                    android:id="@+id/luopanTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="子: 正北水位，阴阳交界，万物根基"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:gravity="center"
                    android:paddingTop="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#40FFFFFF"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/detailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="详细说明"
                    android:textSize="13sp"
                    android:textColor="#B0C4DE"
                    android:gravity="center"
                    android:paddingTop="10dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
