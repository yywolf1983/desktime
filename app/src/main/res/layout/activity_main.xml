<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:padding="8dp"
            android:background="@drawable/card_background"
            android:clickable="true"
            android:focusable="true">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour1TextView"
                android:layout_width="72dp"
                android:layout_height="100dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour2TextView"
                android:layout_width="72dp"
                android:layout_height="100dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="56sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute1TextView"
                android:layout_width="72dp"
                android:layout_height="100dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute2TextView"
                android:layout_width="72dp"
                android:layout_height="100dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/card_background">

            <!-- 第1行: 日期 + 按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/dateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/date_blue"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingVertical="2dp"
                    tools:text="2024年12月31日" />

                <TextView
                    android:id="@+id/resetTimeButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="⟳"
                    android:textSize="18sp"
                    android:textColor="@color/colon_color"
                    android:gravity="center"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_round_transparent"
                    android:contentDescription="恢复当前时间" />

            </LinearLayout>

            <!-- 第2行: 星期 + 节气 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/weekdayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_accent"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    tools:text="星期二" />

                <TextView
                    android:id="@+id/jieqiTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/jieqi_orange"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    tools:text="立春" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/fourPillarsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/gold_faint"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                tools:text="甲辰年 丙子月 乙未日 甲申时" />

            <TextView
                android:id="@+id/copyButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="📋"
                android:textSize="14sp"
                android:textColor="@color/gold_faint"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_round_transparent"
                android:contentDescription="复制派盘信息" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/timeFortuneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/fortune_green"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.06"
                tools:text="子时(23-1点): 阴气最重，宜静养安神" />

            <TextView
                android:id="@+id/panExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/explanation_gray"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.04"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:paddingHorizontal="4dp"
                tools:text="大吉\n气场旺盛 · 万事通达\n宜积极进取" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/card_background">

            <com.example.timedisplay.NinePalacePanel
                android:id="@+id/ninePalacePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="280dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailedInterpretation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/rotationLockButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="🔒"
        android:textSize="18sp"
        android:textColor="@color/gold_faint"
        android:gravity="center"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="锁定/解锁横竖屏" />

</FrameLayout>