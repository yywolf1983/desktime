<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/rotationLockButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="🔒"
        android:textSize="18sp"
        android:textColor="@color/gold"
        android:gravity="center"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="锁定/解锁横竖屏" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_gravity="center">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour1TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour2TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="48sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute1TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute2TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="8dp">

            <TextView
                android:id="@+id/dateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="#6B8DD6"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.08"
                tools:text="2024年12月31日 星期二" />

            <TextView
                android:id="@+id/jieqiTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#FFB84D"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:paddingStart="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                tools:text="立春" />

            <TextView
                android:id="@+id/resetTimeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="8dp">

            <TextView
                android:id="@+id/fourPillarsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="#FFD700"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                tools:text="甲辰年 丙子月 乙未日 甲申时" />

            <TextView
                android:id="@+id/copyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="20sp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:contentDescription="复制派盘信息" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/timeFortuneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8FBC8F"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.04"
                tools:text="子时(23-1点): 阴气最重，宜静养安神" />

            <TextView
                android:id="@+id/panExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.04"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="8dp"
                tools:text="大吉\n吉星高照，诸事顺遂 · 把握良机，大胆行动" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.example.timedisplay.NinePalacePanel
                android:id="@+id/ninePalacePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="280dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detailedInterpretation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>