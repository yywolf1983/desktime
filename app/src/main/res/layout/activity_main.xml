<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="false">

        <!-- 顶部图标行容器（锁/电池/倒计时/功能入口），由代码填充 -->
        <LinearLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            android:scrollbars="none"
            android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="@dimen/home_content_padding_top"
        android:paddingBottom="@dimen/home_content_padding_bottom"
        android:layout_gravity="top">

        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/home_time_container_margin_bottom"
            android:padding="@dimen/home_time_container_padding"
            android:background="@drawable/card_background"
            android:clickable="true"
            android:focusable="true">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour1TextView"
                android:layout_width="@dimen/home_time_digit_width"
                android:layout_height="@dimen/home_time_digit_height" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour2TextView"
                android:layout_width="@dimen/home_time_digit_width"
                android:layout_height="@dimen/home_time_digit_height" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="@dimen/home_time_colon_size"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute1TextView"
                android:layout_width="@dimen/home_time_digit_width"
                android:layout_height="@dimen/home_time_digit_height" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute2TextView"
                android:layout_width="@dimen/home_time_digit_width"
                android:layout_height="@dimen/home_time_digit_height" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/home_date_container_margin_bottom"
            android:paddingHorizontal="12dp"
            android:paddingVertical="@dimen/home_date_container_padding_v"
            android:background="@drawable/card_background">

            <!-- 第1行: 日期 + 按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/dateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/home_date_text_size"
                    android:textColor="@color/date_blue"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingVertical="2dp"
                    tools:text="2024年12月31日" />

                <TextView
                    android:id="@+id/auspiciousButton"
                    android:layout_width="@dimen/home_small_button_size"
                    android:layout_height="@dimen/home_small_button_size"
                    android:text="择"
                    android:textSize="15sp"
                    android:textColor="@color/gold_faint"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_round_transparent"
                    android:contentDescription="吉日查询" />

                <TextView
                    android:id="@+id/resetTimeButton"
                    android:layout_width="@dimen/home_small_button_size"
                    android:layout_height="@dimen/home_small_button_size"
                    android:text="⟳"
                    android:textSize="18sp"
                    android:textColor="@color/colon_color"
                    android:gravity="center"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/btn_round_transparent"
                    android:contentDescription="恢复当前时间" />

            </LinearLayout>

            <!-- 第2行: 星期 + 节气 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/weekdayTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/home_weekday_text_size"
                    android:textColor="@color/text_accent"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    tools:text="星期二" />

                <TextView
                    android:id="@+id/jieqiTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/home_jieqi_text_size"
                    android:textColor="@color/jieqi_orange"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    tools:text="立春" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/fourPillarsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/gold_faint"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                tools:text="甲辰年 丙子月 乙未日 甲申时" />

            <TextView
                android:id="@+id/copyButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="⧉"
                android:textSize="16sp"
                android:textColor="@color/gold_faint"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_round_transparent"
                android:contentDescription="复制排盘信息" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/timeFortuneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:letterSpacing="0.03"
                tools:text="辰(7-9) 胃经当令&#10;宜进朝膳，纳谷最良" />

            <TextView
                android:id="@+id/panStarTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="1sp"
                android:textSize="13sp"
                android:textColor="@color/explanation_gray"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.04"
                tools:text="文星主事，利学业文书" />

            <TextView
                android:id="@+id/panExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="1sp"
                android:textSize="13sp"
                android:textColor="@color/jieqi_orange"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.04"
                tools:text="开门通达，诸事可成" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ninePalaceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/card_background"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.example.timedisplay.NinePalacePanel
                    android:id="@+id/ninePalacePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/ninePalaceChevron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="#88FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:text="奇门九宫"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/detailedInterpretation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>