<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_gravity="center">

        <!-- 时间容器（可点击） -->
        <LinearLayout
            android:id="@+id/timeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour1TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/hour2TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="48sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-black"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:shadowColor="#FF87CEEB"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute1TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/minute2TextView"
                android:layout_width="60dp"
                android:layout_height="75dp" />

        </LinearLayout>

        <!-- 日期显示 -->
        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/tech_blue"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginVertical="8dp"
            android:letterSpacing="0.08"
            android:shadowColor="@color/tech_blue"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            tools:text="2024年12月31日 星期二" />

        <!-- 四柱显示 -->
        <TextView
            android:id="@+id/fourPillarsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/tech_cyan"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginVertical="8dp"
            android:letterSpacing="0.08"
            android:shadowColor="@color/tech_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            tools:text="甲辰年 丙子月 乙未日 甲申时" />

        <!-- 九宫格解释 -->
        <TextView
            android:id="@+id/ninePalaceExplanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/tech_silver"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginVertical="6dp"
            android:letterSpacing="0.08"
            tools:text="九宫格基于当前四柱信息计算" />

        <!-- 九宫格 -->
            <com.example.timedisplay.NinePalacePanel
                android:id="@+id/ninePalacePanel"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="12dp" />

        <!-- 详细解读 -->
        <TextView
            android:id="@+id/detailedInterpretation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>