<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stopwatchLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_background">
            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="←"
                android:textSize="24sp"
                android:textColor="@color/gold"
                android:gravity="center"
                android:clickable="true"
                android:background="@android:color/transparent"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="秒表"
                android:textSize="18sp"
                android:textColor="@color/gold"
                android:gravity="center"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>
            <View
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </LinearLayout>

        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="@drawable/card_background">

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour1"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchHour2"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=":"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute1"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchMinute2"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=":"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond1"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <com.example.timedisplay.SevenSegmentDisplay
                android:id="@+id/stopwatchSecond2"
                android:layout_width="32dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/stopwatchMillis"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text=".00"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_background"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="重置"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:alpha="0.5"
                android:clickable="true" />

            <View
                android:layout_width="8dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/lapButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="分段"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:enabled="false"
                android:alpha="0.5"
                android:clickable="true" />

            <View
                android:layout_width="8dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/startStopButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="开始"
                android:textSize="12sp"
                android:textColor="@color/gold"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:clickable="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_background">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="200dp">

                <LinearLayout
                    android:id="@+id/lapListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal" />

            </ScrollView>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>