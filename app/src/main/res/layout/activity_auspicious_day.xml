<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- 标题卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="择日 · 吉日查询"
                android:textColor="@color/gold"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:text="‹ 返回"
                android:textSize="14sp"
                android:textColor="@color/gold_faint"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_round_transparent"
                android:contentDescription="返回首页" />
        </LinearLayout>

        <!-- 查询范围提示 -->
        <TextView
            android:id="@+id/rangeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text_accent"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:layout_marginBottom="10dp" />

        <!-- 事项分类标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择事项类别"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <!-- 事项分类（动态填充，每行 3 个按钮） -->
        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/gold_separator"
            android:layout_marginBottom="8dp" />

        <!-- 结果标题 -->
        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请选择上方事项以查看吉日"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- 吉日列表 -->
        <ListView
            android:id="@+id/resultList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:background="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

    </LinearLayout>
</FrameLayout>
