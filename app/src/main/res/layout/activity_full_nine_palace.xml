<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:id="@+id/fullNinePalaceLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/fullPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="奇门遁甲排盘"
                android:textColor="#BFA055"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:letterSpacing="0.1"/>





            <com.example.timedisplay.FullNinePalacePanel
                android:id="@+id/fullNinePalacePanel"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="一、基本信息"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expBasic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="二、日时关系"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expGan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="三、方位指导"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expDirection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="四、今日宜忌"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expYiJi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="五、生活提示"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expLife"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="六、各宫要点"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expPalaces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="七、时辰运势"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_border"
                    android:padding="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="20dp"
                    android:elevation="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="八、综合建议"
                        android:textColor="#BFA055"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:paddingBottom="8dp"
                        android:letterSpacing="0.05"/>
                    <TextView
                        android:id="@+id/expOverall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D8D4C8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>