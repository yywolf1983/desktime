<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
        android:id="@+id/fullNinePalaceLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/fullPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="奇门遁甲排盘"
            android:textColor="#87CEEB"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/fullPageFourPillars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ADD8E6"
                android:textSize="24sp"
                android:layout_marginEnd="20dp"/>

            <TextView
                android:id="@+id/fullPagePanelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00BFFF"
                android:textSize="24sp"/>

        </LinearLayout>

        <com.example.timedisplay.FullNinePalacePanel
            android:id="@+id/fullNinePalacePanel"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/fullPageExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#87CEEB"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
