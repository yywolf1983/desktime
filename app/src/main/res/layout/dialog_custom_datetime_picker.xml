<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="24dp"
            android:background="@drawable/card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择日期时间"
                android:textColor="@color/gold_faint"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/gold_separator"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年"
                        android:textColor="@color/gold_faint"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>
                    <NumberPicker
                        android:id="@+id/yearPicker"
                        android:layout_width="80dp"
                        android:layout_height="200dp"
                        android:theme="@style/PickerTextStyle"
                        android:inputType="none"
                        android:descendantFocusability="blocksDescendants"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="月"
                        android:textColor="@color/gold_faint"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>
                    <NumberPicker
                        android:id="@+id/monthPicker"
                        android:layout_width="70dp"
                        android:layout_height="200dp"
                        android:theme="@style/PickerTextStyle"
                        android:inputType="none"
                        android:descendantFocusability="blocksDescendants"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="日"
                        android:textColor="@color/gold_faint"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>
                    <NumberPicker
                        android:id="@+id/dayPicker"
                        android:layout_width="70dp"
                        android:layout_height="200dp"
                        android:theme="@style/PickerTextStyle"
                        android:inputType="none"
                        android:descendantFocusability="blocksDescendants"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时"
                        android:textColor="@color/gold_faint"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>
                    <NumberPicker
                        android:id="@+id/hourPicker"
                        android:layout_width="70dp"
                        android:layout_height="200dp"
                        android:theme="@style/PickerTextStyle"
                        android:inputType="none"
                        android:descendantFocusability="blocksDescendants"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分"
                        android:textColor="@color/gold_faint"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>
                    <NumberPicker
                        android:id="@+id/minutePicker"
                        android:layout_width="70dp"
                        android:layout_height="200dp"
                        android:theme="@style/PickerTextStyle"
                        android:inputType="none"
                        android:descendantFocusability="blocksDescendants"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/gold_separator"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 当日宜忌"
                    android:textColor="@color/gold_faint"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvYiJi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:text="加载中..."/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/gold_separator"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="取消"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/border_light"
                    android:layout_marginHorizontal="16dp"/>

                <TextView
                    android:id="@+id/confirmButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="确定"
                    android:textColor="@color/gold_faint"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>