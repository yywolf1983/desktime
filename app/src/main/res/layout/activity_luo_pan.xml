<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/luoPanContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_background">

            <com.example.timedisplay.LuoPanView
                android:id="@+id/luoPanView"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/infoScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="通俗解读"
                        android:textSize="16sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="9dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="综合总评"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:id="@+id/luopanSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="旋转罗盘选择方位查看详情"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="9dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <TextView
                        android:id="@+id/directionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坎(北)"
                        android:textSize="22sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:layout_marginRight="16dp" />
                    <TextView
                        android:id="@+id/mountainInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坐山: 子"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="9dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <TextView
                            android:id="@+id/wuxingInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="五行: 水"
                            android:textSize="13sp"
                            android:textColor="@color/wuxing_water"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/shierZhixingInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地支: 子"
                            android:textSize="13sp"
                            android:textColor="@color/text_accent"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tianganInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="天干: 壬"
                            android:textSize="13sp"
                            android:textColor="@color/success"
                            android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/baguaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="八卦: 坎"
                            android:textSize="13sp"
                            android:textColor="@color/wuxing_water"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/chaoXiangInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="朝向: 午"
                            android:textSize="13sp"
                            android:textColor="@color/success"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/nayinInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="纳音: 桑柘木"
                            android:textSize="13sp"
                            android:textColor="@color/wuxing_wood"
                            android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/shenshaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="神煞: 天德"
                            android:textSize="13sp"
                            android:textColor="@color/warning"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/jixiongInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="吉凶: 吉"
                            android:textSize="13sp"
                            android:textColor="@color/success"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/diguiInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="归藏: 水"
                            android:textSize="13sp"
                            android:textColor="@color/text_accent"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="9dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="方位综合解读"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="东方"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_wood"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：震卦·木·青龙【吉】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/eastZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜开门纳气，旺文昌"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/eastShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜高耸苍翠，忌破碎低矮"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/eastLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建书房、开门，忌尖角冲射"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="南方"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_fire"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：离卦·火·朱雀【吉】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜开门纳阳气，旺事业"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜端庄秀丽，忌尖射冲煞"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建客厅、开门，忌阴暗潮湿"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="西方"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_metal"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：兑卦·金·白虎【平】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/westZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜纳气平和，利口才"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/westShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜驯服柔顺，忌高大雄健"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/westLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建厨房储藏室，忌高大建筑"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="北方"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_water"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：坎卦·水·玄武【凶】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜有水蓄财，忌开门纳气"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜厚实稳重，忌空虚塌陷"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建水池，忌开门高大障碍"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="东南"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_wood"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：巽卦·木·青龙【吉】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southeastZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜开门纳气，旺文昌"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southeastShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜清秀高耸，忌堵塞压迫"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southeastLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建书房办公，忌堵塞污秽"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="西南"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_earth"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：坤卦·土·白虎【平】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southwestZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜纳气稳重，旺人丁"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southwestShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜稳重厚实，忌陡峭险峻"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/southwestLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建卧室储藏室，忌空旷尖角"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="西北"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_metal"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：乾卦·金·玄武【平】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northwestZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜纳气尊贵，旺贵人"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northwestShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜高大雄伟，忌低洼潮湿"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northwestLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建主卧书房，忌低洼潮湿"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="东北"
                        android:textSize="13sp"
                        android:textColor="@color/wuxing_earth"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="格局：艮卦·土·青龙【吉】"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northeastZhaoxiang"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="坐向：宜开门纳气，旺贵人"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northeastShuisha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="砂水：宜敦厚稳重，忌崩塌破碎"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                        <TextView
                            android:id="@+id/northeastLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="布局：宜建大门靠山，忌低洼道路直冲"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="1dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="9dp"
                        android:layout_marginBottom="10dp"
                    android:background="@drawable/card_background">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="山水风水"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/shanshuiFengshui"
                        android:layout_width="match_parent"
