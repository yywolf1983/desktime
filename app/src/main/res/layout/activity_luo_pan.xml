<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <com.example.timedisplay.LuoPanView
            android:id="@+id/luoPanView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#1A000000">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📜 罗盘使用说明"
                    android:textSize="20sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧭 基本操作"
                    android:textSize="16sp"
                    android:textColor="#87CEEB"
                    android:textStyle="bold"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 触摸并拖动罗盘可以旋转查看不同方位\n• 红色箭头指向正南方向，固定不动\n• 罗盘可360度自由旋转"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗺️ 罗盘层次"
                    android:textSize="16sp"
                    android:textColor="#87CEEB"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 最外层：二十四山向（天地人三元）\n• 第二层：八卦符号\n• 第三层：八宫方位\n• 第四层：十二地支\n• 第五层：十天干\n• 中心：太极点"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ 二十四山向"
                    android:textSize="16sp"
                    android:textColor="#87CEEB"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="壬子癸 丑艮寅 甲卯乙 辰巽巳 丙午丁 未坤申 庚酉辛 戌乾亥\n\n每个方位15度，共24个方位，对应二十四节气"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📖 八卦含义"
                    android:textSize="16sp"
                    android:textColor="#87CEEB"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☰ 乾-西北-天 ☷ 坤-西南-地 ☳ 震-东方-雷 ☴ 巽-东南-风\n☵ 坎-北方-水 ☲ 离-南方-火 ☶ 艮-东北-山 ☱ 兑-西方-泽"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔮 使用提示"
                    android:textSize="16sp"
                    android:textColor="#87CEEB"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 可用于风水方位勘察\n• 查找建筑物的坐山朝向\n• 配合日课时使用更佳\n• 旋转时保持心静气和"
                    android:textSize="14sp"
                    android:textColor="#ADD8E6"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>
