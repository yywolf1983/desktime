<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/frosted_glass_background"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:clickable="true"
                android:onClick="goBack"
                android:background="?android:attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textSize="24sp"
                    android:textColor="#FF87CEEB"/>
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="二十四"
                android:textSize="18sp"
                android:textColor="#FF87CEEB"
                android:gravity="center"
                android:fontFamily="sans-serif-light"
                android:textStyle="bold"/>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2287CEEB"
            android:layout_marginVertical="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginHorizontal="4dp">

            <TextView
                android:id="@+id/jieqiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42sp"
                android:textColor="#FFD700"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:shadowColor="#88FFD700"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/jieqiEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FF87CEEB"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/jieqiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FFA500"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:background="#111122">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="传统习俗"
                    android:textSize="16sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tradition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/prevJieqiLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:paddingHorizontal="12dp">
                    <TextView
                        android:id="@+id/prevJieqi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#FFADD8E6"
                        android:fontFamily="sans-serif-light"/>
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#3387CEEB"
                    android:layout_marginHorizontal="12dp"/>

                <TextView
                    android:id="@+id/jieqiPhenomenon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-light"
                    android:paddingHorizontal="12dp"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#3387CEEB"
                    android:layout_marginHorizontal="12dp"/>

                <LinearLayout
                    android:id="@+id/nextJieqiLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:paddingHorizontal="12dp">
                    <TextView
                        android:id="@+id/nextJieqi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#FFADD8E6"
                        android:fontFamily="sans-serif-light"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_background"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="#111122"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/hou1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-light"/>
                <TextView
                    android:id="@+id/hou1Days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="#111122"
                android:layout_marginBottom="4dp">
                <TextView
                    android:id="@+id/hou2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-light"/>
                <TextView
                    android:id="@+id/hou2Days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="#111122">
                <TextView
                    android:id="@+id/hou3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="#FF87CEEB"
                    android:fontFamily="sans-serif-light"/>
                <TextView
                    android:id="@+id/hou3Days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/daysToNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#FFA500"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:background="#111122"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_background"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#FFD700"
                    android:shape="oval"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全年节气"
                    android:textSize="18sp"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/jieqiListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>