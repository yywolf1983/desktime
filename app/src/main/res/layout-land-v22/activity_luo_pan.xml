<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.timedisplay.FrostedGlassBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/card_background">

            <com.example.timedisplay.LuoPanView
                android:id="@+id/luoPanView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxWidth="320dp"
                android:maxHeight="320dp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:id="@+id/directionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坎(北)"
                        android:textSize="20sp"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:layout_marginRight="16dp" />

                    <TextView
                        android:id="@+id/mountainInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="坐山: 子"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/wuxingInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="五行: 水"
                            android:textSize="12sp"
                            android:textColor="@color/wuxing_water"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/shierZhixingInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="地支: 子"
                            android:textSize="12sp"
                            android:textColor="@color/text_accent"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tianganInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="天干: 壬"
                            android:textSize="12sp"
                            android:textColor="@color/success"
                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/baguaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="八卦: 坎"
                            android:textSize="12sp"
                            android:textColor="@color/wuxing_water"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chaoXiangInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="朝向: 午"
                            android:textSize="12sp"
                            android:textColor="@color/success"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/nayinInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="纳音: 桑柘木"
                            android:textSize="12sp"
                            android:textColor="@color/wuxing_wood"
                            android:gravity="center" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/shenshaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="神煞: 天德"
                            android:textSize="12sp"
                            android:textColor="@color/warning"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/jixiongInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="吉凶: 吉"
                            android:textSize="12sp"
                            android:textColor="@color/success"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/diguiInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="归藏: 水"
                            android:textSize="12sp"
                            android:textColor="@color/text_accent"
                            android:gravity="center" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 坐山提示"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/luopanTips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="子: 正北水位，阴阳交界，万物根基"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📌 坐向分析"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/zhaoxiangAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="坐子向午，水火既济，主富贵双全"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏔 砂水判断"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/shuishaAnalysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="北方宜有水，南方宜有山，青龙高耸，白虎柔顺"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏠 八宅吉凶"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/bazhaiDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ 九星飞宫"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/jiuxingDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚪 八门遁法"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/bamenDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏗 建筑建议"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/buildingAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="宜坐北朝南，大门宜开南方或东南方，忌开北方"
                        android:textSize="12sp"
                        android:textColor="@color/success"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💫 命理提示"
                        android:textSize="13sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/mingliInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="子年生人属鼠，五行属水，性格聪明伶俐，机智灵活"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📋 综合总结"
                        android:textSize="14sp"
                        android:textColor="@color/gold"
                        android:layout_marginBottom="4dp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/gold_separator"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/summaryInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="坐山：子，五行属水，坐北朝南，吉利方位：东南、东方、东北"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</FrameLayout>
